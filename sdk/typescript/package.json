{
  "name": "@rungated/sdk",
  "version": "0.10.0",
  "description": "TypeScript SDK for the Rungated runtime AI agent firewall",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@langchain/core": "^0.3.0",
    "@types/node": "^22.0.0",
    "openai": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "zod": "^3.23.0"
  },
  "homepage": "https://docs.rungated.com",
  "keywords": [
    "ai",
    "agents",
    "security",
    "llm",
    "mcp",
    "guardrails",
    "firewall"
  ]
}